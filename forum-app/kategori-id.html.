<!DOCTYPE html>
<html lang="id-ID">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saluran Diskusi - Forum Indonesia</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen p-4 md:p-8">

    <div class="max-w-2xl mx-auto bg-white rounded-3xl shadow-xl p-6 md:p-10">
        
        <a href="index.html" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-blue-600 mb-6 transition-colors">
            <span class="mr-2">←</span> Kembali ke Dashboard
        </a>

        <h1 class="text-3xl font-extrabold text-gray-800 mb-2">Saluran Diskusi 🇮🇩</h1>
        <p class="text-gray-500 mb-6">Pilih saluran yang ada, atau buat saluran baru Anda sendiri!</p>

        <!-- Form Pembuatan Saluran Baru -->
        <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 mb-8 flex gap-2">
            <input type="text" id="input-kategori" placeholder="Contoh: Info Loker Jakarta..." class="flex-1 bg-white border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-700" maxlength="30">
            <button id="btn-buat" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-xl transition-colors shadow-md">
                Buat
            </button>
        </div>

        <!-- Tempat Saluran Akan Ditampilkan Otomatis -->
        <div id="daftar-kategori" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="col-span-full text-center py-8 text-gray-400">
                Memuat saluran...
            </div>
        </div>

    </div>

    <!-- Script Firebase (Versi Modular) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getFirestore, collection, addDoc, onSnapshot, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        // ========================================================
        // HAPUS KODE DI BAWAH INI DAN GANTI DENGAN FIREBASE CONFIG ANDA
        // ========================================================
        const firebaseConfig = {
            apiKey: "AIzaSyContohKodeAnda...",
            authDomain: "forum-app-anda.firebaseapp.com",
            projectId: "forum-app-anda",
            storageBucket: "forum-app-anda.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456:web:abcdefg"
        };
        // ========================================================

        // Inisialisasi Firebase & Database
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Elemen HTML
        const inputKategori = document.getElementById('input-kategori');
        const btnBuat = document.getElementById('btn-buat');
        const daftarKategori = document.getElementById('daftar-kategori');

        // Fungsi membuat format URL (Slug). Contoh: "Info Loker" jadi "info-loker"
        function buatSlug(teks) {
            return teks.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-');
        }

        // 1. Fungsi Menyimpan Saluran Baru ke Database
        btnBuat.addEventListener('click', async () => {
            const nama = inputKategori.value.trim();
            if (!nama) return alert('Nama saluran tidak boleh kosong!');
            
            const slug = buatSlug(nama);
            btnBuat.disabled = true;
            btnBuat.innerText = "...";

            try {
                // Menyimpan ke koleksi bernama 'kategori_id'
                await addDoc(collection(db, "kategori_id"), {
                    nama: nama,
                    slug: slug,
                    waktu: serverTimestamp()
                });
                inputKategori.value = ''; // Kosongkan input setelah berhasil
            } catch (error) {
                console.error("Error:", error);
                alert("Gagal membuat saluran.");
            } finally {
                btnBuat.disabled = false;
                btnBuat.innerText = "Buat";
            }
        });

        // 2. Fungsi Mengambil & Menampilkan Saluran Secara Real-time
        const q = query(collection(db, "kategori_id"), orderBy("waktu", "desc"));
        onSnapshot(q, (snapshot) => {
            daftarKategori.innerHTML = ''; // Kosongkan layar loading
            
            if (snapshot.empty) {
                daftarKategori.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400">Belum ada saluran. Jadilah yang pertama membuat!</div>';
                return;
            }

            snapshot.forEach((doc) => {
                const data = doc.data();
                // Membuat elemen HTML untuk setiap saluran
                const htmlSaluran = `
                    <a href="forum.html?ruang=${data.slug}" class="p-5 bg-white border border-gray-200 rounded-2xl hover:border-red-500 hover:shadow-md transition-all group cursor-pointer flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-bold text-gray-800 group-hover:text-red-600"># ${data.nama}</h2>
                        </div>
                        <div class="text-gray-300 group-hover:text-red-500">→</div>
                    </a>
                `;
                daftarKategori.insertAdjacentHTML('beforeend', htmlSaluran);
            });
        });
    </script>
</body>
</html>
